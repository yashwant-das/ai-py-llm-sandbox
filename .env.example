# GenAI LLM Sandbox - environment template
# Copy to .env and uncomment one provider block.

# -----------------------------------------------------------------------------
# Option A: NVIDIA (cloud)
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...
# LLM_MODEL_ID=meta/llama-3.1-8b-instruct
# LLM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# LLM_EMBEDDING_MODEL=nvidia/nv-embed-v1
# LLM_IMAGE_MODEL=stabilityai/stable-diffusion-xl

# -----------------------------------------------------------------------------
# Option B: OpenAI (cloud)
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL_ID=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o-mini
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# LLM_IMAGE_MODEL=gpt-image-1

# -----------------------------------------------------------------------------
# Option C: LM Studio (local OpenAI-compatible)
# -----------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL_ID=<your-loaded-chat-model>
# LLM_VISION_MODEL=<your-loaded-vision-model>
# LLM_EMBEDDING_MODEL=<your-loaded-embedding-model>
# LLM_IMAGE_MODEL=<your-loaded-image-model>

# -----------------------------------------------------------------------------
# Option D: Ollama (separate local demo uses these values)
# -----------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_ID=gpt-oss:20b
# LLM_VISION_MODEL=qwen3-vl:30
# LLM_EMBEDDING_MODEL=nomic-embed-text:latest
# LLM_IMAGE_MODEL=bx/flux2-klein

# -----------------------------------------------------------------------------
# Required for vision demo
# -----------------------------------------------------------------------------
# VISION_IMAGE_PATH=data/sample.jpg
