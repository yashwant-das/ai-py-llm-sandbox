# GenAI Systems Playground - Environment Configuration
# Copy this file to .env and customize for your setup

# =============================================================================
# OPTION 1: NVIDIA API (Cloud - Default)
# =============================================================================
# Get key: https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-your-key-here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL_ID=meta/llama-3.1-405b-instruct
# LLM_API_KEY=${NVIDIA_API_KEY}

# =============================================================================
# OPTION 2: Ollama (Local)
# =============================================================================
# Download: https://ollama.com/
# Run: ollama serve
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_ID=llama3

# =============================================================================
# OPTION 3: LM Studio (Local)
# =============================================================================
# Start server in LM Studio app
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL_ID=your-downloaded-model

# =============================================================================
# OPTION 4: OpenAI / Groq / Others
# =============================================================================
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL_ID=gpt-4o

# =============================================================================
# Optional Settings
# =============================================================================
# LOG_LEVEL=INFO
