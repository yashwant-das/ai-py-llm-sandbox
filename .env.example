# GenAI Systems Playground - environment template
# Copy to .env and uncomment one provider block.

# -----------------------------------------------------------------------------
# Option A: NVIDIA (cloud)
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...
# LLM_MODEL_ID=meta/llama-3.1-8b-instruct
# LLM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# LLM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# -----------------------------------------------------------------------------
# Option B: OpenAI (cloud)
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL_ID=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o-mini
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Option C: LM Studio (local OpenAI-compatible)
# -----------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL_ID=<your-loaded-chat-model>
# LLM_VISION_MODEL=<your-loaded-vision-model>
# LLM_EMBEDDING_MODEL=<your-loaded-embedding-model>

# -----------------------------------------------------------------------------
# Option D: Ollama (separate local demo uses these values)
# -----------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL_ID=llama3.1:8b

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# VISION_IMAGE_PATH=data/sample.jpg
# NVIDIA_API_KEY=nvapi-...   # only needed for nvidia_image_gen.py if LLM_API_KEY is unset
