# GenAI Systems Playground - Environment Configuration
# Copy this file to .env and customize for your setup

# =============================================================================
# LM Studio Configuration (Default - Local LLM)
# =============================================================================
# LM Studio must be running with the local server enabled
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
DEFAULT_MODEL=openai/gpt-oss-20b
DEFAULT_TEMPERATURE=0.1

# =============================================================================
# Ollama Configuration (Alternative Local LLM)
# =============================================================================
# Ollama provides an easy way to run open-source models locally
# Install: https://ollama.com/
# Usage: ollama pull llama3.1 && ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_DEFAULT_MODEL=gpt-oss:20b

# =============================================================================
# OpenAI Configuration (Optional - for cloud models)
# =============================================================================
# Uncomment and set if you want to use OpenAI API instead of local models
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=  # Optional: for OpenAI-compatible APIs (e.g., Groq, Together)

# =============================================================================
# Search APIs (for agent examples)
# =============================================================================
# SerpAPI for Google search capabilities
# Get key at: https://serpapi.com/
SERPAPI_API_KEY=

# DuckDuckGo search (no API key required, used by default)

# =============================================================================
# Hugging Face Configuration (Topic 17)
# =============================================================================
# Required for downloading models and accessing gated repos
# Get token at: https://huggingface.co/settings/tokens
# HUGGINGFACE_TOKEN=hf_your_token_here

# =============================================================================
# Application Settings
# =============================================================================
LOG_LEVEL=INFO

# Default LLM provider for examples (lmstudio, ollama, openai, auto)
LLM_PROVIDER=lmstudio

# =============================================================================
# Cloud Provider API Keys (Optional - for specific topics)
# =============================================================================
# MISTRAL_API_KEY=  # La Plateforme API
# GROQ_API_KEY=     # For fast Llama inference
# ANTHROPIC_API_KEY=  # Claude API
