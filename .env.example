# NVIDIA-hosted demo configuration.
# Copy .env.example to .env and replace the API key placeholder.

# --- NVIDIA API endpoints and credentials ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
LLM_API_KEY=nvapi-...

# --- Models used by the demos (all hosted by NVIDIA) ---
# Chat, prompting, tool calling, safety, setup, and RAG answers.
LLM_MODEL_ID=nvidia/nemotron-3.5-lightning-30b-a3b
# Image understanding in vision_basics.py.
LLM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# Document/query embeddings in embeddings_basics.py and basic_rag.py.
LLM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Image generation through NVIDIA's Visual GenAI endpoint.
LLM_IMAGE_MODEL=black-forest-labs/flux.1-dev

# --- Vision demo input ---
# Included synthetic red-and-blue image; replace with your own path if desired.
VISION_IMAGE_PATH=data/sample.png

# Chat demos disable thinking to preserve their small output budgets.
# Embedding demos send documents as passage and questions as query.
